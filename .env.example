# Vyala environment
# Copy this file to .env.local and fill in your own keys.
# Nothing here is a real credential.

# 1. Clerk: dashboard.clerk.com, create an application, then Configure, API keys.
#    The publishable key begins "pk_", the secret key begins "sk_".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# 2. MongoDB Atlas: create a free cluster, add a database user, then
#    Connect, Drivers, Node.js, and copy the connection string.
#    Patient documents are stored in GridFS inside the same database.
MONGODB_URI=your-mongodb-connection-string
MONGODB_DB=vyala
